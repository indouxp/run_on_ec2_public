# 環境変数テンプレート
# このファイルをコピーして .env を作成し、各値を設定してください
# cp .env.skl .env

# AWSアカウントID
export AWS_ACCOUNT_ID=

# 通知メールアドレス (run.conf: mail)
export MAIL=

# SMS送信先電話番号 (run.conf: sms)
export SMS=

# SES送信元メールアドレス (run.conf: ses_from_email)
export SES_FROM_EMAIL=

# デフォルトAMI ID (run.conf: default_ami_id)
export DEFAULT_AMI_ID=
